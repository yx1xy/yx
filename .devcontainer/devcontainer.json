{
  "name": "Kali Linux",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "root",
  "containerUser": "root",
  "overrideCommand": true,
  "forwardPorts": [2222],
  "postStartCommand": "mkdir -p /run/sshd && (pgrep -x sshd >/dev/null || /usr/sbin/sshd)",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "shutdownAction": "stopContainer"
}